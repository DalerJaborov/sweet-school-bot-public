{
  "name": "@sweet-school/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:watch": "vitest",
    "test:legacy": "tsx tests/commentBackfill.test.ts && tsx tests/clientLanguage.test.ts && tsx tests/debounceSerialization.test.ts && tsx tests/orderRequest.test.ts && tsx tests/receiptDate.test.ts && tsx tests/testimonialDoubt.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backfill:courses": "tsx scripts/backfill-courses.ts",
    "backup:db": "tsx scripts/backup-db.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
