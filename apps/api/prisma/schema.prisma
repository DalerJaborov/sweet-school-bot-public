// Sweet School Bot — воронки и ИИ-консультант для Instagram кондитерской школы.
// База — SQLite-файл: одна школа, нагрузка маленькая, зато ноль настройки.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // Без явного списка Prisma угадывает движок по окружению сборки и в Docker
  // берёт openssl-1.1.x, которого в рантайме нет — контейнер падает на старте.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

/// Журнал отказов интеграций — персистентный, переживает перезапуск контейнера
/// (30.08.2026, разбор живого случая: реклама привела человека в директ, ответа
/// не было, а причину узнать не вышло — `logError` писал только в docker logs,
/// и контейнер перезапустился раньше, чем кто-то заглянул в консоль).
///
/// Устроен как в Royal Home CRM (apps/api/src/lib/systemError.ts того проекта):
/// та же дедупликация по первым 160 символам за 10 минут (одна сломанная
/// интеграция иначе даёт тысячи одинаковых строк на каждое сообщение), и то же
/// правило «в Telegram — только на ДЕЙСТВИТЕЛЬНО новый вид поломки», не на
/// каждый повтор уже известной.
model ErrorLog {
  id        String   @id @default(uuid())
  source    String
  message   String
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

/// Ключ-значение для всего, что вбивается со страницы настроек:
/// igToken, igBusinessId, verifyToken, aiEnabled, aiPrompt, geminiKey…
/// Значения хранятся строками; булевы — "true"/"false".
model Setting {
  key   String @id
  value String
}

/// Человек из Instagram или Messenger.
///
/// ID выдаёт сам канал и в разных каналах они из разных пространств — один и тот
/// же человек, написавший и в Instagram, и в Messenger, для нас два контакта.
/// Поэтому уникальность составная: канал + id, а не просто id (иначе чужой
/// Messenger-ID мог бы совпасть с инстаграмным и склеить две переписки в одну).
model Contact {
  id                   String           @id @default(uuid())
  /// INSTAGRAM | MESSENGER | WEB (чат на сайте; igUserId = id посетителя из куки)
  channel              String           @default("INSTAGRAM")
  igUserId             String
  username             String?
  /// JSON-массив меток, например ["kurs_started"]. Аналог тегов ManyChat.
  tags                 String           @default("[]")
  /// Прислал чек, ИИ признал его настоящим — ссылка доступа уже отправлена.
  paid                 Boolean          @default(false)
  paidAt               DateTime?
  /// До этого момента бот молчит с этим человеком — потому что в переписку
  /// ответила ЖИВАЯ хозяйка из приложения Instagram (эхо-событие без нашего mid).
  /// null — бот отвечает как обычно.
  humanSilencedUntil   DateTime?
  /// Заблокирован ботом за флирт/оскорбления/спам/видео без текста (ai/abuseFilter.ts,
  /// webhook.ts). Бот молчит, входящие пишутся; снимается из панели «Ученицы».
  spamBlockedAt        DateTime?
  spamReason           String?
  /// Личный контакт хозяйки (мама, сестра, подруга) — бот выключен НАВСЕГДА, а не
  /// на 20 минут. Ставится вручную из панели или само, когда бот видит по
  /// переписке, что это родня, а не клиент.
  personal             Boolean          @default(false)
  /// Почему помечен личным — чтобы владелец видел, кто и на каком основании
  /// попал в этот список, и мог снять отметку.
  personalReason       String?
  /// Одноразовая ссылка-приглашение, которую мы выдали этому человеку. По ней
  /// узнаём его в Telegram: когда он входит в группу, Telegram присылает
  /// событие со ссылкой, по которой он вошёл — так связываются Instagram-клиент
  /// и его Telegram-аккаунт. Иначе отобрать доступ было бы не у кого.
  inviteLink           String?
  /// Telegram-id того, кто вошёл по нашей ссылке.
  telegramUserId       String?
  /// Когда вошёл в группу. null — ссылку получил, но не воспользовался: такому
  /// человеку стоит напомнить, деньги он уже отдал.
  joinedGroupAt        DateTime?
  /// Доступ отобран (фальшивый чек). Хранится, чтобы человек не получил вторую
  /// ссылку по новой попытке и чтобы видеть историю.
  accessRevokedAt      DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  messages             Message[]
  deliveries           Delivery[]
  receiptChecks        ReceiptCheck[]
  pendingAiReplies     PendingAiReply[]
  followUpSends        FollowUpSend[]
  offlineSignup        OfflineSignup?
  purchases            Purchase[]
  styleExamples        StyleExample[]
  /// ---- платформа: ОДНА ссылка на человека (03.09.2026) ----
  /// jti действующей ссылки на платформу. Раньше жил на Purchase — и купившая
  /// оба курса получала две ссылки и два окна. Теперь ссылка одна, внутри —
  /// все оплаченные курсы; докупленный появляется в том же окне сам.
  accessTokenId        String?          @unique
  accessIssuedAt       DateTime?
  devices              Device[]
  certificates         Certificate[]
  /// Самообслуживание «это мой новый телефон»: сколько раз за окно ученица
  /// сама заменила самое старое устройство и когда в последний раз. Больше
  /// двух в месяц — уже похоже на раздачу, дальше только через владельца.
  deviceSwaps          Int              @default(0)
  deviceSwapAt         DateTime?
  /// Когда в последний раз попросили прислать альтернативный скриншот чека
  /// (другой ракурс/из истории банка) вместо того, чтобы сразу звать владельца
  /// решать руками. null — не спрашивали (или уже сбросили после решения).
  /// Один шанс самому разобраться — второй такой же подряд чек уходит владельцу
  /// как раньше, не спрашиваем бесконечно.
  askedAltScreenshotAt DateTime?
  /// Напоминание «оплатил, но не зашёл в группу» уже отправлено — второй раз не шлём.
  joinReminderAt       DateTime?
  /// Когда последний раз ушёл РЕАЛЬНОВРЕМЕННЫЙ алерт «разговор застрял» в Telegram
  /// владельцу и сестре (см. stuckAlert.ts) — не даёт слать чаще, чем раз в
  /// cooldown (Setting `stuckAlertCooldownHours`, по умолчанию 2 часа). Это НЕ то
  /// же самое, что секция «где бот застрял» в вечерней сводке (dailyReport.ts) —
  /// та сканирует всю таблицу раз в сутки и не смотрит на это поле вовсе: она
  /// страховка на случай, если live-алерт не сработал (слишком длинный cooldown,
  /// пропустили пуш), а не то же самое предупреждение.
  stuckAlertSentAt     DateTime?
  /// Когда этому человеку УЖЕ отправили скриншот отзыва (см. ai/testimonials.ts) —
  /// ставится один раз и назад не откатывается, как learningCheckInSentAt у
  /// Purchase. Цель — не задавить сомневающегося человека доказательствами: одно
  /// живое фото сильнее убеждает, чем то же самое фото по кругу на каждое
  /// сомнение подряд.
  testimonialSentAt    DateTime?
  /// Настоящее имя и аватар из профиля — их отдаёт Graph по igUserId. Нужны,
  /// чтобы в панели были живые люди с лицами, а не голые идентификаторы.
  /// Пусто — человек не дал согласия на доступ к профилю (частый случай, когда
  /// он пришёл из рекламы), тогда рисуем кружок с буквой.
  name                 String?
  avatarUrl            String?
  /// Когда профиль спрашивали в последний раз: ссылка на аватар протухает, а
  /// повторять запрос на каждый показ списка — впустую жечь лимиты Graph.
  profileAt            DateTime?
  /// ---- платформа курсов ----
  /// Имя и фамилия, которые ученица вводит САМА при первом входе на платформу.
  /// Instagram-ник и имя профиля для поиска не годятся: ник бывает вроде
  /// "sweet_girl_2007", а имя профиля часто пустое или в эмодзи. Эти же поля —
  /// второй фактор при восстановлении доступа с ДРУГОГО аккаунта: чек можно
  /// переслать подруге, а что человек вписал в приложении — нет.
  studentFirstName     String?
  studentLastName      String?
  /// Язык платформы, выбранный явно при входе: ru | tg. Отличается от
  /// определения по тексту (ai/clientLanguage.ts) — то догадка по переписке,
  /// это осознанный выбор, и он важнее.
  preferredLanguage    String?
  /// Карточка офлайн-курса (цена, даты, адрес) уже отправлена этому человеку.
  /// Ставится один раз: спросил повторно — не заваливаем той же простынёй,
  /// дальше разговор ведёт обычный консультант (см. ai/offlineCourse.ts).
  offlineInfoSentAt    DateTime?

  @@unique([channel, igUserId])
  // Индекс существует в базе с 20260821190000_group_access (поиск контакта по
  // ссылке в handleChatMember), но раньше отсутствовал здесь в схеме — из-за
  // этого расхождения последующий `prisma migrate dev` тихо сгенерировал бы
  // DROP INDEX как часть НЕсвязанной миграции. Возвращаем объявление на место,
  // чтобы новая миграция (learningCheckIn/decidedAt) была строго аддитивной.
  @@index([inviteLink])
}

/// Разбор присланного фото-чека. Пишется только для похожего на чек изображения —
/// фото десерта или мем сюда не попадают, чтобы список не зарастал шумом.
model ReceiptCheck {
  id            String    @id @default(uuid())
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// valid — похож на настоящий перевод на наши реквизиты, ссылка ушла сама;
  /// suspicious — похож на чек, но что-то не сходится (не тот получатель, размыто,
  /// не похоже на перевод) — ссылку не шлём, смотреть тут и решать руками.
  kind          String
  confidence    Int
  reason        String
  linkSent      Boolean   @default(false)
  /// Ждёт решения владельца в Telegram: PENDING — карточка с кнопками отправлена;
  /// APPROVED/REJECTED — владелец нажал; null — решение не требовалось (бот
  /// разобрался сам).
  ownerDecision String?
  /// Ссылка на присланную картинку (наш /media/...), чтобы показать её владельцу
  /// в Telegram и оставить в журнале «Чеки».
  imageUrl      String?
  /// Сумма с чека в сомони, если её удалось прочитать — по ней считается выручка
  /// в утренней сводке и выбирается группа курса. null — не разобрана.
  amount        Int?
  /// SHA-256 присланной картинки — по нему ловим переслан ли ЭТОТ ЖЕ скриншот
  /// второй раз (тем же человеком или другим, кому его переслали).
  /// @unique, а не просто @@index: receiptRetry.ts УЖЕ ловил "уникальность
  /// отпечатка" как ожидаемый исход гонки (комментарий предполагал защиту в
  /// БД) — на деле constraint отсутствовал, защиты не было. Один и тот же
  /// скриншот, посланный двум РАЗНЫМ contactId почти одновременно (переслал
  /// другу), мог открыть доступ дважды. Прод проверен на дубли перед миграцией
  /// (25.08.2026, 0 дублей) — см. ai.ts create() на P2002 при этом поле.
  imageHash     String    @unique
  /// Дата/время, которые видны прямо НА чеке (если разборчиво) — не время, когда
  /// сообщение дошло до бота. Старый или из будущего чек — повод не доверять.
  receiptAt     DateTime?
  createdAt     DateTime  @default(now())
  /// Когда владелец нажал «Подтвердить»/«Отклонить» в Telegram (или чек закрылся
  /// автоматически без карточки) — раньше было видно только createdAt (когда чек
  /// пришёл), а сколько он провисел без решения — нет.
  decidedAt     DateTime?
  /// Когда клиентке ушло «чек получила, передаю Ширин» после эскалации к
  /// владельцу. Страховка от повтора: тот же чек может пройти через разбор
  /// дважды (сразу и из очереди перепроверки), а сообщение должно уйти один раз.
  customerNotifiedAt DateTime?
}

/// Журнал вызовов Gemini — модель, токены, оценочная стоимость (см. ai/pricing.ts).
///
/// До 30.08.2026 расход на ИИ не считался НИКАК — только число успешных ответов
/// в суточном бюджете (ai/dailyBudget.ts), а деньги там ни при чём: посчитать,
/// сколько реально стоит бот, было не по чему вообще. Тот же принцип, что в
/// основной CRM (её AiLog) — endpoint у каждого места свой, чтобы разбор "куда
/// уходят деньги" не сводился к одной непонятной сумме.
model AiLog {
  id              String   @id @default(uuid())
  endpoint        String
  /// Модель на момент вызова. null — вызов провалился ещё до ответа Google
  /// (все ключи/модели отказали), считать стоимость не с чего.
  model           String?
  inputTokens     Int?
  outputTokens    Int?
  /// Кэш Google тарифицирует иначе — здесь только чтение, записи мы не делаем.
  cacheReadTokens Int?
  /// Стоимость вызова в долларах по цене на момент записи. null — цена для
  /// этой модели неизвестна ИЛИ вызов провалился (см. model выше).
  costUsd         Float?
  ms              Int
  ok              Boolean
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

/// Реплика клиента, на которую ИИ НИ РАЗУ не ответил (все ключи/модели Gemini
/// отказали) — тот же принцип, что у ReceiptCheck выше: не терять лида молча,
/// а положить в очередь и пробовать снова фоновым тиком.
///
/// Живой повод (29-30.08.2026): у Google кончились предоплаченные кредиты на
/// ~17 часов, aiReply при отказе только писала в лог и молчала НАВСЕГДА — 4
/// реальных обращения "хочу курс" не получили ни одного ответа, разобрать
/// пришлось руками через SSH. У приёма чеков (receiptRetry.ts) такая защита
/// уже была, у обычного ответа — нет.
model PendingAiReply {
  id            String   @id @default(uuid())
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// Смерженный текст хода (то же, что ушло бы в aiReply при обычном вызове).
  text          String
  /// Момент последнего входящего сообщения НА МОМЕНТ постановки в очередь.
  /// Если к попытке повтора появилось входящее свежее этого момента — сам ход
  /// уже устарел (новое сообщение либо ответили, либо оно встало в очередь
  /// своей записью) и эта строка тихо снимается, не расходуя попытку.
  snapshotAt    DateTime
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([nextAttemptAt])
}

/// Журнал переписки — и входящие, и то, что отправил бот.
model Message {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction String // IN | OUT
  /// message_id от Meta. Уникален — это же и защита от повторной доставки вебхука.
  mid       String?  @unique
  text      String?
  /// payload нажатой кнопки (только у входящих).
  payload   String?
  /// Публичная копия присланной/отправленной картинки — нужна чату на сайте,
  /// чтобы показать чек в ленте (у Instagram картинка живёт у Meta, не у нас).
  imageUrl  String?
  /// Исходящее написал ЖИВОЙ человек (Ширин из приложения), а не бот.
  ///
  /// Раньше отличить их было нельзя: и наш ответ, и её эхо ложились одинаковыми
  /// строками с direction=OUT. А различие важное — каждый её ответ следом за
  /// ответом бота означает «бот сказал не то, вот как надо». Это готовый список
  /// проблемных мест, ради которого не нужно просить её что-то отмечать руками.
  byHuman   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Воронка. trigger:
///  COMMENT — человек прокомментировал публикацию (первый шаг уходит private reply);
///  DM      — человек сам написал в директ.
model Funnel {
  id              String       @id @default(uuid())
  name            String
  enabled         Boolean      @default(false)
  trigger         String // COMMENT | DM
  /// Для COMMENT: адреса публикаций (для памяти — какие ссылки сюда привязаны).
  postUrl         String?
  /// JSON-массив ID публикаций/роликов, под которыми срабатывает воронка. Пусто —
  /// под любой (тогда решает anyComment/keywords, как раньше). Непустой список —
  /// воронка с кнопками жёсткой продажи звучит только под ЭТИМИ роликами; под
  /// остальными комментарий получает обычный тёплый ответ от ИИ, без кнопок.
  mediaIds        String       @default("[]")
  /// JSON-массив ключевых слов; пустой + anyComment=false — не срабатывает.
  keywords        String       @default("[]")
  /// Отвечать на любой комментарий под публикацией, без ключевого слова.
  anyComment      Boolean      @default(false)
  /// Метка, которая вешается при старте — по ней видно в карточке, что человек
  /// уже проходил эту воронку.
  startTag        String       @default("kurs_started")
  /// Через сколько дней один и тот же человек может пройти воронку ЗАНОВО.
  /// 30 — раз в месяц (по умолчанию): человек, который спросил месяц назад и не
  /// купил, к следующей кампании уже забыл, а слать ему то же самое трижды за
  /// неделю — это спам. 0 — только один раз навсегда.
  repeatAfterDays Int          @default(30)
  steps           FunnelStep[]
  deliveries      Delivery[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

/// ОДНА КУПЛЕННАЯ ГРУППА. Курса два (за 50 и за 70 сомони), и человек может
/// купить сначала один, потом второй — или оба сразу одним переводом. Пока
/// «оплатил» был одной галочкой на человеке, второй курс выдать было нечем:
/// код видел `paid=true` и молчал. Теперь каждая покупка — своя строка.
model Purchase {
  id                    String    @id @default(uuid())
  contactId             String
  contact               Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// COURSE50 | COURSE70 — какая именно закрытая группа куплена.
  course                String
  /// Сколько сомони засчитано за ЭТУ группу (после перевода из валюты).
  amount                Int
  /// Что реально стояло на чеке — для отчёта по деньгам.
  rawAmount             Float?
  currency              String?
  /// Ссылка-приглашение именно в эту группу и вошёл ли по ней человек.
  inviteLink            String?
  joinedAt              DateTime?
  revokedAt             DateTime?
  /// «Как первый урок?» — проверочное сообщение отправлено (см. learningCheckIn.ts).
  /// null — ещё не отправляли (или отправлять пока рано — joinedAt слишком свежий).
  learningCheckInSentAt DateTime?
  /// Ответила ли ученица хоть что-то ПОСЛЕ проверочного сообщения выше — реального
  /// прочтения урока Bot API не показывает (нет receipts на посты в канале), поэтому
  /// это практический прокси-сигнал «жива, вовлечена», а не факт просмотра урока.
  /// Ставится один раз и назад не откатывается.
  startedLearning       Boolean   @default(false)
  createdAt             DateTime  @default(now())

  /// ---- собственная платформа курсов (см. docs/course-platform-design.md) ----
  ///
  /// Связь с курсом как с записью в таблице, а не строкой `course` выше. Пока
  /// nullable: код продолжает ходить по строке, пока backfill не проставит id
  /// всем существующим покупкам (шаг 2 миграции). NOT NULL — отдельным релизом.
  courseId         String?
  courseRef        Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// jti выданной magic link. Хранится, чтобы отозвать ОДНУ ссылку, не меняя
  /// общий JWT-секрет (иначе отзыв у одного человека разлогинил бы всех).
  accessTokenId    String?             @unique
  accessIssuedAt   DateTime?
  /// Первый вход на платформу — веб-аналог joinedAt для Telegram-группы.
  /// null через сутки после выдачи = повод напомнить (см. joinReminder.ts).
  firstOpenedAt    DateTime?
  /// Откуда взялась покупка: RECEIPT — чек через бота (сегодня единственный
  /// путь), MANUAL — владелец выдал руками. PAYMENT появится вместе с платёжкой.
  source           String              @default("RECEIPT")
  /// Сколько раз бот САМ перевыдавал ссылку по просьбе «не открывается»
  /// (см. course/recovery.ts) и когда в последний раз. Нужны, чтобы отличить
  /// «потеряла ссылку» от «раздаёт знакомым»: после третьего раза за месяц
  /// случай уходит владельцу, а не решается автоматически.
  linkReissueCount Int                 @default(0)
  linkReissuedAt   DateTime?
  devices          Device[]
  progress         Progress[]
  chat             CourseChatMessage[]

  /// Одна группа — одна покупка: повторный чек не выдаёт вторую ссылку туда же.
  @@unique([contactId, course])
  @@index([createdAt])
}

/// Чёрный список отпечатков чеков. Один фальшивый скриншот часто ходит по рукам:
/// сюда он попадает после первого же разоблачения и дальше отбивается сразу,
/// без похода в ИИ и без карточки владельцу.
model BlockedReceipt {
  imageHash String   @id
  reason    String
  createdAt DateTime @default(now())
}

/// Запись на ОФЛАЙН-курс. Предоплаты нет — деньги берут с первого занятия,
/// поэтому чек здесь не при чём: нужны только имя и номер, чтобы позвонить.
model OfflineSignup {
  id             String    @id @default(uuid())
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  /// Уведомление сестре ушло — чтобы не слать второй раз при повторной записи.
  notified       Boolean   @default(false)
  /// Напоминание за сутки до начала курса уже отправлено (см. offlineReminder.ts).
  /// Ставится ДО отправки: обещано одно напоминание, и пропустить его при сбое
  /// лучше, чем прислать дважды.
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  /// Один человек — одна запись: повторное «запишите меня» не плодит дубли.
  @@unique([contactId])
}

/// Живой пример «как отвечает сама хозяйка»: вопрос клиента и её настоящий ответ.
///
/// САМООБУЧЕНИЕ БЕЗ ПЕРЕПИСЫВАНИЯ ПРОМТА. Промт владельца — закон, его меняет
/// только он сам. Бот учится иначе: собирает реальные пары «вопрос → ответ
/// хозяйки» (из прошлых переписок и из тех случаев, когда она вмешалась в
/// разговор живьём) и подмешивает лучшие из них в запрос как ОБРАЗЦЫ СТИЛЯ.
/// Так модель перенимает манеру, а правила остаются под контролем человека.
model StyleExample {
  id               String   @id @default(uuid())
  /// Что написал клиент (может быть пусто — иногда хозяйка пишет первой).
  clientText       String
  /// Что ответила хозяйка — это и есть эталон.
  ownerText        String
  /// HISTORY — вытащено из прошлых переписок; TAKEOVER — она вмешалась в живой
  /// разговор бота (значит бот ответил плохо, а она показала как надо).
  source           String
  /// Разговор закончился оплатой — такие примеры ценнее всего: они не просто
  /// «в её стиле», а реально привели к продаже.
  ledToSale        Boolean  @default(false)
  /// Отключить пример, если он неудачный. Владелец видит список в панели.
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  /// Сам файл — голосовое/фото/видео, если хозяйка ответила не только текстом.
  /// Своя копия (Instagram отдаёт короткоживущие ссылки), см. ai/ownerMedia.ts.
  mediaUrl         String?
  /// audio | image | video — пусто, если ownerText обычный текст без вложения.
  mediaType        String?
  /// Отмечено вручную (владелец/хозяйка в панели) как «можно переслать этот файл
  /// клиенту на похожий вопрос». Без отметки медиа копится только для архива —
  /// в живые ответы бота не попадает.
  approvedForReuse Boolean  @default(false)
  /// Чей это разговор — null у HISTORY-импорта (сотни прошлых Instagram-тредов
  /// без гарантированной привязки к текущим Contact) и у старых строк до этой
  /// миграции. Заведено для markExamplesAsSuccessful: раньше бонус ledToSale
  /// раздавался по совпадению ТЕКСТА ответа глобально — типовая фраза («курс
  /// 50 сомони, оплата на карту...») из ЧУЖИХ, неуспешных переписок ошибочно
  /// получала бонус в score() только потому, что кто-то другой купил и написал
  /// похожими словами. С contactId бонус достаётся только СВОИМ примерам.
  contactId        String?
  contact          Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([clientText, ownerText])
}

/// Скриншот настоящего отзыва ученицы (из карусели/актуального в Instagram
/// хозяйки), который бот может ОТПРАВИТЬ ПРЯМО В ДИРЕКТ, а не просто дать на
/// него ссылку. Ссылку на актуальное с отзывами человек часто не открывает —
/// картинка, положенная прямо в переписку, работает сильнее.
model Testimonial {
  id          String    @id @default(uuid())
  /// Наш /media/... (тот же общий загрузчик, что у шагов воронки — upload.ts).
  imageUrl    String
  /// Подпись к отправке. Пусто — уходит нейтральная фраза по умолчанию
  /// (см. ai/testimonials.ts), а не голая картинка без единого слова.
  caption     String?
  /// Выключить пример из ротации, не удаляя его насовсем.
  active      Boolean   @default(true)
  /// Когда этот отзыв последний раз ушёл кому-то — по этому полю крутится
  /// пул: следующим всегда уходит тот, у кого lastShownAt самый старый (или
  /// null — ещё ни разу не показывали), чтобы разные отзывы чередовались, а
  /// не заваливали клиентов одной и той же картинкой.
  lastShownAt DateTime?
  createdAt   DateTime  @default(now())
  /// Ключ идемпотентности для разового автоимпорта (Фаза 3 плана «максимальное
  /// использование архива», ai/testimonialImport.ts) — например "qa:<QaMessage.id>".
  /// Ручные загрузки через панель (POST /admin/testimonials) его не ставят,
  /// поэтому null допустим. Не даёт повторному запуску импорта наплодить
  /// одни и те же черновики второй раз.
  sourceRef   String?   @unique
}

/// Догоняющее сообщение: человек прошёл воронку, но не оплатил — через
/// afterHours бот сам напоминает о себе. Отдельно от FunnelStep нарочно: шаги
/// идут подряд внутри одного разговора, а догоняющие — это возврат к остывшему
/// человеку через часы и дни, со своим правилом «уже оплатил — не слать».
model FollowUp {
  id         String         @id @default(uuid())
  /// Через сколько часов после последнего шага воронки отправить.
  afterHours Int
  text       String
  mediaUrl   String?
  mediaType  String?
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  sends      FollowUpSend[]
}

/// Кому какое догоняющее уже ушло — чтобы не слать одно и то же дважды.
model FollowUpSend {
  id         String   @id @default(uuid())
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followUpId, contactId])
}

/// Один шаг цепочки. Шаги идут по order; шаг с кнопками ставит цепочку на паузу —
/// продолжение придёт с той кнопки, которую нажмёт человек (payload = id целевого шага).
model FunnelStep {
  id           String  @id @default(uuid())
  funnelId     String
  funnel       Funnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  order        Int
  /// Пауза перед отправкой ЭТОГО шага, в секундах.
  delaySeconds Int     @default(0)
  text         String
  /// JSON-массив [{ "title": "...", "targetStepId": "..." }]. До 3 кнопок, надпись ≤ 20 симв.
  buttons      String  @default("[]")
  /// Ссылка на видео/картинку/файл, отправится вложением после текста.
  mediaUrl     String?
  mediaType    String? // video | image | file
  /// true — после этого шага цепочка завершена, даже если есть шаги дальше
  /// (нужно для веток: ветка «АРТ-десерт» кончается, не переползая в «21 рецепт»).
  stopAfter    Boolean @default(false)

  @@unique([funnelId, order])
}

/// Прохождение конкретного человека по конкретной воронке.
model Delivery {
  id          String    @id @default(uuid())
  funnelId    String
  funnel      Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// ACTIVE — идёт по шагам; WAITING — ждёт нажатия кнопки; DONE; FAILED.
  state       String    @default("ACTIVE")
  /// order шага, который отправится следующим (для ACTIVE).
  nextOrder   Int       @default(0)
  /// Когда пора отправлять следующий шаг. null у WAITING/DONE/FAILED.
  nextRunAt   DateTime?
  /// Комментарий, с которого всё началось (для trigger=COMMENT).
  commentId   String?
  commentText String?
  lastError   String?
  /// Сколько раз подряд не удалось отправить текущий шаг (30.08.2026).
  ///
  /// До этого один отказ Instagram API сразу переводил доставку в FAILED
  /// НАВСЕГДА — а `state: "ACTIVE"` берёт для повтора только runDueDeliveries,
  /// FAILED она не трогает никогда. Живой случай: человек написал с рекламы,
  /// воронка начала стартовать, отправка первого шага не удалась, и ответа не
  /// было вовсе — ни от воронки, ни от обычного бота (webhook.ts считает
  /// воронку «обработавшей» комментарий, даже если она не смогла отправить).
  /// Теперь отказ уходит в растущую паузу (тот же приём, что в
  /// aiReplyRetry.ts), а не сразу хоронит разговор.
  failCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Один человек проходит одну воронку один раз — защита от повторной выдачи.
  @@unique([funnelId, contactId])
  @@index([state, nextRunAt])
}

/// Обработанные комментарии — чтобы повторная доставка вебхука не слала второй ответ.
model SeenComment {
  commentId String   @id
  createdAt DateTime @default(now())
}

/// Сырой лог сообщений учебной Telegram-группы (владелец 24.08.2026: хочет
/// сначала «полностью изучить» всё, что там пишут ученицы и что отвечает
/// Ширин, прежде чем бот начнёт отвечать сам). Отдельно от Message (та таблица
/// про Instagram-переписку с клиентами) и от StyleExample нарочно: тон и
/// содержание учебной группы — техника готовки — не должны попасть в продающий
/// промт Instagram-директа (см. qaGroup.ts).
///
/// Архив ПРОШЛЫХ сообщений группы через бота не достать — у Telegram Bot API
/// нет метода истории чата, бот видит только то, что происходит после того, как
/// его добавили. Эта таблица копится только вперёд, с момента подключения.
model QaMessage {
  id             String   @id @default(uuid())
  chatId         String
  telegramUserId String?
  telegramMsgId  Int?
  /// Написала Ширин (владелица школы), а не ученица.
  fromOwner      Boolean  @default(false)
  text           String?
  mediaUrl       String?
  mediaType      String?
  createdAt      DateTime @default(now())

  @@index([chatId, createdAt])
}

/// Пара «вопрос ученицы → ответ Ширин» из учебной группы — собирается из
/// QaMessage, когда приходит сообщение от владелицы (см. qaGroup.ts). Свой пул,
/// не смешивается со StyleExample (продающая манера Instagram-директа).
model QaExample {
  id               String   @id @default(uuid())
  studentText      String
  ownerText        String
  mediaUrl         String?
  mediaType        String?
  createdAt        DateTime @default(now())
  /// Отмечено вручную (владелец/Ширин в панели) как «можно переслать этот файл
  /// клиенту на похожий вопрос» — тот же смысл, что StyleExample.approvedForReuse.
  /// Без отметки медиа копится только для архива, в живые ответы не попадает.
  approvedForReuse Boolean  @default(false)

  @@unique([studentText, ownerText])
}

// ============================================================================
// СОБСТВЕННАЯ ПЛАТФОРМА КУРСОВ
//
// Заменяет доставку курса ссылкой в закрытую Telegram-группу: около половины
// клиенток без Telegram, со слабым телефоном или из России, где нужен VPN.
// Полный проект и решения владельца — docs/course-platform-design.md.
// ============================================================================

/// Курс как товар. Заменяет константы COURSE50/COURSE70 в courses.ts: пока они
/// в коде, добавить третий курс нельзя без правки и деплоя.
model Course {
  id          String     @id @default(uuid())
  /// Стабильный код, совпадает с Purchase.course сегодня: "COURSE50" | "COURSE70".
  /// По нему backfill связывает старые покупки с новыми записями.
  code        String     @unique
  title       String
  description String?
  /// Цена в сомони — тот же смысл, что PRICE в courses.ts.
  price       Int
  coverUrl    String?
  active      Boolean    @default(true)
  /// Сколько устройств открывает курс по одной покупке. Два — телефон и
  /// компьютер одного человека; третье просит обратиться к владельцу.
  /// Три, а не два: ссылка из директа открывается во ВСТРОЕННОМ браузере
  /// Instagram, а смотреть человек идёт в обычный — это уже два разных
  /// браузера на одном телефоне. При лимите два настоящий второй телефон
  /// (или планшет) уже не помещался, и живая ученица упиралась в отказ.
  /// Два: телефон и ещё одно (планшет, ноутбук). Разные браузеры одного
  /// телефона считаются одним устройством (access.ts). Как у GetCourse —
  /// исследование рынка 03.09.2026.
  deviceLimit Int        @default(2)
  order       Int        @default(0)
  /// НАБОР ИНСТРУМЕНТОВ (визуальная система 04.09.2026, §5) — JSON-массив
  /// {name, photoUrl, toolNumber, buyLink}: насадки, формы и т.п., которые
  /// использует школа. Фото загружает владелец в панели (тот же /admin/upload,
  /// что у отзывов); "[]" — по умолчанию, экран инструментов тогда пуст, а не
  /// падает.
  toolsData   String     @default("[]")
  modules     Module[]
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  certificates Certificate[]
}

/// Раздел курса. Курс с одним разделом рисуется как простой список уроков —
/// лишний уровень в интерфейсе не показывается.
model Module {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int
  lessons  Lesson[]

  @@unique([courseId, order])
}

/// Урок: видео плюс рецепт под ним.
model Lesson {
  id               String              @id @default(uuid())
  moduleId         String
  module           Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title            String
  order            Int
  /// Манифест HLS в бакете: "courses/<курс>/<урок>/master.m3u8". Внутри две
  /// дорожки: 720p для онлайна и 480p — её же качает офлайн-кеш телефона.
  /// null — видео ещё не загружено или транскодинг не закончился.
  hlsPath          String?
  /// Исходник до транскодинга. Хранится, чтобы перекодировать заново (сменили
  /// битрейт, добавили качество), не прося у владельца файл второй раз.
  sourcePath       String?
  /// UPLOADED — файл в бакете, очередь на транскодинг; PROCESSING — FFmpeg
  /// работает; READY — можно смотреть; FAILED — смотреть причину в логе.
  status           String              @default("UPLOADED")
  durationSec      Int?
  /// Ключ AES-128 (base64), которым зашифрованы сегменты урока. Шифрование —
  /// штатная часть HLS (#EXT-X-KEY), а не самодельная схема. Плеер получает
  /// ключ отдельным запросом; офлайн берёт из хранилища телефона, пока
  /// действует ключ устройства (Device.offlineKeyExpiresAt).
  encryptionKey    String?
  /// РЕЦЕПТ одним полем (решение владельца 03.09.2026): текст как есть,
  /// переносы строк сохраняются, вёрстка на странице. Без конструктора шагов —
  /// его пришлось бы наполнять по кусочкам, а рецепты уже написаны целиком.
  /// РАСШИФРОВКА ОЗВУЧКИ УРОКА. Всё, что владелица проговорила в видео, текстом.
  /// Делается один раз при загрузке урока: звук вынимается тем же проходом
  /// ffmpeg, что и перекодировка, и уходит в Gemini. Нужна помощнику по
  /// рецептам: в видео обычно сказано втрое больше, чем написано в рецепте
  /// («смотрите, тесто должно тянуться вот так»), и без расшифровки бот на
  /// половину вопросов честно отвечает «в материалах этого нет».
  transcript       String?
  /// PENDING | READY | FAILED | SKIPPED — SKIPPED, когда расшифровка выключена
  /// владельцем или Gemini недоступен, и урок работает без неё.
  transcriptStatus String              @default("PENDING")
  recipeText       String?
  /// СТРУКТУРИРОВАННЫЙ РЕЦЕПТ (визуальная система 04.09.2026, §2) — тот же
  /// разбор cardOcr.ts, что и recipeText, но как JSON {title, components:
  /// [{name, items: [{ingredient, amount, unit, note, emoji}]}], language}, а
  /// не готовый markdown. Нужен карточке рецепта v2 на телефоне: чекбокс
  /// «собрала» и пересчёт граммов ×0.5/×2 требуют структуры, разбирать
  /// markdown обратно на клиенте — ненадёжно. null у уроков без распознавания
  /// карточки (рецепт вписан текстом вручную) — тогда экран показывает
  /// recipeText как раньше, простым текстом.
  recipeData       String?
  /// Фото к рецепту: JSON-массив путей в бакете, порядок = порядок показа.
  recipePhotos     String              @default("[]")
  /// Файлы на скачивание: JSON-массив {title, path}.
  attachments      String              @default("[]")
  /// Бесплатный урок: открыт без покупки — им бот показывает товар лицом.
  /// Откуда урок пришёл при импорте: "tg:<chatId>:<messageId>" для экспорта
  /// Telegram Desktop. Повторный импорт той же папки пропускает уже созданные.
  importedFrom        String?   @unique
  /// Кадр с третьей секунды видео (JPEG в хранилище) — обложка в списке уроков.
  /// Если у урока есть тизер, обложка берётся с его последнего кадра.
  posterPath          String?
  /// ОБЛОЖКИ, СГЕНЕРИРОВАННЫЕ ИЗ posterPath/тизера (`storage/coverArt.ts`):
  /// coverPath — 1280×720 JPEG для списков/панели/og:image, storyPath —
  /// 1080×1920 JPEG для геройского экрана урока и шаринга в сторис/WhatsApp.
  /// Рендерятся автоматически после транскода; null — рендер ещё не делали
  /// (старый урок до бэкфилла) или он не задался — тогда используется posterPath.
  coverPath            String?
  storyPath            String?
  /// ТИЗЕР — короткий ролик-анонс из канала школы (9–24 с). teaserPath —
  /// исходник в бакете ("sources/<id>-teaser.mp4"), teaserMp4Path — готовый
  /// mp4 480p ("courses/<модуль>/<урок>/teaser.mp4"), его и отдаёт API.
  teaserPath          String?
  teaserMp4Path       String?
  /// Откуда взялся recipeText: null — написан владельцем, "card-ocr" —
  /// распознан с фото-карточки при импорте и ждёт проверки.
  recipeSource        String?
  /// Владелица ПРОВЕРИЛА распознанный рецепт (экран «Проверить рецепты»,
  /// 05.09.2026): цифры с карточки сверены глазами. null при recipeSource =
  /// "card-ocr" — бейдж «с карточки, не проверено» и место в очереди на главной.
  recipeReviewedAt    DateTime?
  isPreview        Boolean             @default(false)
  /// КОРЗИНА («Утро Ширин» §19, 05.09.2026): «Удалить» в панели ставит эту
  /// отметку, а не стирает строку. 24 часа урок можно вернуть; потом
  /// lessonTrash.ts удаляет строку и файлы в хранилище. Все пути чтения
  /// (ученица, каталог, метрики, сертификат) фильтруют deletedAt = null.
  deletedAt        DateTime?
  progress         Progress[]
  chat             CourseChatMessage[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([moduleId, order])
  @@index([deletedAt])
}

/// Устройство, с которого открыт курс: защита от раздачи ссылки и носитель
/// офлайн-доступа. Одна покупка — не больше Course.deviceLimit устройств.
model Device {
  id                  String    @id @default(uuid())
  /// Якорная покупка — на переходный релиз; настоящая принадлежность теперь
  /// contactId. Станет необязательным отдельным релизом (пересоздание таблицы).
  purchaseId          String
  purchase            Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// Устройство принадлежит ЧЕЛОВЕКУ, а не покупке: оба курса открываются в
  /// одном окне на одних и тех же телефонах.
  contactId           String?
  contact             Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// СЛУЧАЙНАЯ МЕТКА, ВЫДАННАЯ СЕРВЕРОМ, — настоящий признак устройства.
  /// Лежит в httpOnly-куке: из JavaScript не читается, без нашей базы не
  /// подделывается. Отпечаток браузера ниже присылает сам клиент, поэтому
  /// опознавать по нему нельзя — десять подруг с одним и тем же присланным
  /// значением считались бы одним устройством.
  secret              String?   @unique
  /// Хэш отпечатка браузера. Оставлен как СВЕДЕНИЕ для владельца («похоже, тот
  /// же аппарат»), а не как ключ опознания.
  fingerprint         String
  userAgent           String?
  lastIp              String?
  /// Город по IP: одновременный вход из двух далёких городов — повод заблокировать
  /// и сказать владельцу (ссылку передали), а не молча пустить.
  lastCity            String?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  /// До какого момента на этом устройстве расшифровываются скачанные уроки.
  /// Продлевается на 30 дней при ЛЮБОМ обращении к API — ученица ничего не
  /// нажимает. Истёк — офлайн-копия не открывается и просит выйти в сеть на
  /// минуту; отозванный доступ так же гаснет сам, без интернета у вора.
  offlineKeyExpiresAt DateTime?
  blockedAt           DateTime?
  blockedReason       String?

  @@unique([purchaseId, fingerprint])
  @@index([contactId])
}

/// Прогресс по уроку: одна строка на пару «покупка + урок», обновляется, а не
/// растёт. По ней же решается, что оставить в телефоне офлайн.
model Progress {
  id          String    @id @default(uuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Где остановилась — чтобы открыть урок с того же места, а не с начала.
  positionSec Int       @default(0)
  percent     Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([purchaseId, lessonId])
}

/// ЧАТ С УЧИТЕЛЬНИЦЕЙ. Лента одна на покупку, а не на урок: lessonId говорит,
/// про что спрашивают, но разговор общий — иначе ученица теряет свои же вопросы,
/// а Ширин видит беседу кусками.
///
/// Отвечает сначала бот — её же прошлым ответом на близко совпавший вопрос
/// (ai/qaGroupReply.ts, архив QaExample), ровно как уже работает в учебной
/// Telegram-группе. Не нашёл совпадения — молчит и зовёт Ширин.
model CourseChatMessage {
  id            String    @id @default(uuid())
  purchaseId    String
  purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  /// true — написала ученица; false — ответ (живая Ширин или бот).
  fromStudent   Boolean
  text          String?
  mediaUrl      String?
  mediaType     String?
  /// Ответ собран ботом из архива, а не написан живой Шириной. Ученице этого не
  /// показываем (для неё это ответ школы), владельцу в панели — да.
  byBot         Boolean   @default(false)
  /// message_id в Telegram владельца: её ответ реплаем возвращается в эту ленту.
  telegramMsgId Int?
  /// Прочитано владельцем — красная точка в панели.
  readByOwnerAt DateTime?
  /// Написано без сети и доставлено позже: в ленте помечается временем отправки,
  /// а не временем доставки, иначе разговор выглядит переставленным.
  queuedOffline Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([purchaseId, createdAt])
}

/// ПЕРЕВОД ДЛЯ ПЛАТФОРМЫ — кеш, а не хранилище смысла.
///
/// Названия уроков и тексты рецептов Ширин пишет по-русски. Ученица, выбравшая
/// таджикский, должна видеть их на своём языке, и переводит их Gemini — так
/// решил владелец. Но платить за один и тот же перевод при каждом открытии
/// списка уроков незачем, а главное — без сети или при отказе Gemini экран
/// обязан открыться. Поэтому перевод считается один раз и живёт здесь.
///
/// Ключ — хеш исходного текста, а не id урока: поправили рецепт — хеш другой,
/// старый перевод не подставится молча вместо нового текста.
model Translation {
  id        String   @id @default(uuid())
  /// sha256 исходного текста, hex.
  hash      String
  /// Язык назначения: ru | tg.
  lang      String
  text      String
  createdAt DateTime @default(now())

  @@unique([hash, lang])
}

/// СЕРТИФИКАТ о прохождении курса (владелец 03.09.2026). Одна запись на пару
/// «человек + курс»: перевыпуск с исправленным именем обновляет её, номер
/// остаётся. PDF не хранится — собирается из шаблона за миллисекунды
/// (course/certificate.ts).
model Certificate {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Имя и фамилия так, как ученица ввела их для документа.
  fullName  String
  /// ru | tg — язык последнего скачивания; при следующем можно выбрать другой.
  lang      String   @default("ru")
  /// Порядковый номер для человека — печатается как №, никогда не меняется.
  number    Int
  issuedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, courseId])
}
