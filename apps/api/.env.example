# Скопируй в .env и заполни
DATABASE_URL="file:./dev.db"
PORT=4100
JWT_SECRET=поменяй-на-длинную-случайную-строку
ADMIN_PASSWORD=пароль-входа-в-панель
# Прокси до graph.instagram.com, если с сервера напрямую не достучаться (можно пусто)
IG_PROXY_BASE=
# Ключ авторизации для прокси (если требуется)
# IG_PROXY_KEY=
# Публичный адрес бота — нужен для загрузки медиа в воронках (Meta скачивает файлы по этому URL)
# PUBLIC_BASE_URL=https://your-domain.com

# ElevenLabs: озвучка голосом Ширин (ai/voiceClone.ts). Пусто — функция выключена.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
# Голос: модель eleven_v4 / eleven_v4_turbo (владелец 08.11.2026; v3 — прежняя). Ползунки подбираются на слух на сайте ElevenLabs.
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.9
# Метка эмоции в начале голосового, например [warm]; пусто — без метки.
ELEVENLABS_TAG=
