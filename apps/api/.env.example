# Скопируй в .env и заполни
DATABASE_URL="file:./dev.db"
PORT=4100
JWT_SECRET=поменяй-на-длинную-случайную-строку
ADMIN_PASSWORD=пароль-входа-в-панель
# Прокси до graph.instagram.com, если с сервера напрямую не достучаться (можно пусто)
IG_PROXY_BASE=
# Ключ авторизации для прокси (если требуется)
# IG_PROXY_KEY=
# Публичный адрес бота — нужен для загрузки медиа в воронках (Meta скачивает файлы по этому URL)
# PUBLIC_BASE_URL=https://your-domain.com
