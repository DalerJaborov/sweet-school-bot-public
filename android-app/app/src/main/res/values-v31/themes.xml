<resources>
    <!-- Android 12+ (API 31): используем настоящий системный Splash Screen API
         вместо самодельного фона темы — иконка анимированно уменьшается сама,
         системе не нужен код в Activity, только эти атрибуты темы.
         Родитель — НАШ обычный AppCompat-тема, а не android:Theme.SplashScreen:
         это скрытый (@hide) системный стиль, extends от него роняет линковку
         ресурсов ("resource not found"); публичны только сами атрибуты
         windowSplashScreen*, их и добавляем прямо в свою тему.
         android:postSplashScreenTheme здесь не нужен — это API библиотеки
         androidx core-splashscreen (которую мы сознательно не подключаем),
         у голого системного API нет отдельной "темы после заставки": система
         сама убирает заставку, когда Activity отрисовала первый кадр, и под
         ней остаётся обычное окно активности с тем же Theme.ShirinSweets. -->
    <style name="Theme.ShirinSweets.Splash" parent="Theme.ShirinSweets">
        <item name="android:windowSplashScreenBackground">@color/raspberry</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
